// Sabhi Lead Platform data model. See docs/PLAN.md section 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ACCOUNT_MANAGER
  CLIENT_ADMIN
  CLIENT_MEMBER
}

enum ActiveStatus {
  active
  disabled
}

enum LpStatus {
  active
  paused
}

enum FieldRole {
  name
  phone
  email
}

enum LeadEventType {
  created
  duplicate_of
  status_changed
  note
  assigned
  call
  whatsapp
  follow_up_set
  meta_sent
  edited
  tags_changed
}

enum IntegrationType {
  meta
  whatsapp
  webhook
}

model Client {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  status       ActiveStatus @default(active)
  /// Secret in the client's single webhook URL: /api/hook/{webhookToken}
  webhookToken String       @unique @map("webhook_token")
  createdAt    DateTime     @default(now()) @map("created_at")
  /// Client logo (PNG / JPEG / WebP, small), shown on their pages and their login link.
  logo          Bytes?
  logoType      String?   @map("logo_type")
  logoUpdatedAt DateTime? @map("logo_updated_at")

  users          User[]
  landingPages   LandingPage[]
  leads          Lead[]
  pipelineStages PipelineStage[]
  integrations   Integration[]
  managers       ClientManager[]
  dailyCounts    LeadDailyCount[]

  @@map("clients")
}

model User {
  id           String       @id @default(cuid())
  clientId     String?      @map("client_id")
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         Role
  status       ActiveStatus @default(active)
  lastLoginAt  DateTime?    @map("last_login_at")
  /// Sessions issued before this are signed out (password changed or reset).
  passwordChangedAt DateTime? @map("password_changed_at")
  /// Leads newer than this count as "new" in the notification bell.
  leadsSeenAt       DateTime? @map("leads_seen_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lpAccess       UserLpAccess[]
  managedClients ClientManager[]
  ownedLeads     Lead[]          @relation("LeadOwner")
  events         LeadEvent[]
  passwordResets PasswordReset[]
  columnPrefs    ColumnPref[]
  notifications  Notification[]

  @@index([clientId])
  @@map("users")
}

/// Errors seen by the app (server, background jobs, browsers), grouped by fingerprint.
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  source      String
  message     String
  stack       String?
  path        String?
  context     Json      @default("{}")
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([lastSeenAt])
  @@map("error_logs")
}

/// In-app notifications (the bell): failed webhooks, quiet landing pages, errors.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  clientId  String?   @map("client_id")
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Columns a user hid from the leads table, per view ("all" or a client id).
model ColumnPref {
  userId    String   @map("user_id")
  scope     String
  hidden    String[] @default([])
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
  @@map("column_prefs")
}

/// Sign-in attempts, for limiting password guessing (per email and per IP).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// One-time "forgot password" links. Only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// Account managers (Sabhi staff) are assigned to specific clients.
model ClientManager {
  userId   String @map("user_id")
  clientId String @map("client_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@map("client_managers")
}

model UserLpAccess {
  userId String @map("user_id")
  lpId   String @map("lp_id")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lp   LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)

  @@id([userId, lpId])
  @@map("user_lp_access")
}

model LandingPage {
  id                 String   @id @default(cuid())
  clientId           String   @map("client_id")
  name               String
  lpKey              String   @unique @map("lp_key")
  allowedDomains     String[] @map("allowed_domains")
  status             LpStatus @default(active)
  currentFormVersion String?  @map("current_form_version")
  /// How the client webhook recognises this LP: "host/path" of the page, or "form:<name>".
  sourceKey          String?  @map("source_key")
  sourceUrl          String?  @map("source_url")
  autoCreated        Boolean  @default(false) @map("auto_created")
  createdAt          DateTime @default(now()) @map("created_at")
  /// When the "no leads for a day" alert last went out (once per quiet spell).
  quietAlertedAt     DateTime? @map("quiet_alerted_at")

  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fields       FormField[]
  formVersions FormVersion[]
  leads        Lead[]
  userAccess   UserLpAccess[]

  @@unique([clientId, sourceKey])
  @@index([clientId])
  @@map("landing_pages")
}

model FormField {
  id           String     @id @default(cuid())
  lpId         String     @map("lp_id")
  fieldKey     String     @map("field_key")
  label        String // latest label sent by the form
  displayLabel String?    @map("display_label") // admin rename, wins over label
  inputType    String     @map("input_type")
  options      Json?
  role         FieldRole?
  isHidden     Boolean    @default(false) @map("is_hidden")
  /// Shown in another column (field manager "merge"): that column's key.
  mergeInto    String?    @map("merge_into")
  position     Int        @default(0)
  firstSeenAt  DateTime   @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime   @default(now()) @map("last_seen_at")

  lp LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)

  @@unique([lpId, fieldKey])
  @@map("form_fields")
}

model FormVersion {
  id          String   @id @default(cuid())
  lpId        String   @map("lp_id")
  versionHash String   @map("version_hash")
  fieldKeys   String[] @map("field_keys")
  createdAt   DateTime @default(now()) @map("created_at")

  lp    LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@unique([lpId, versionHash])
  @@map("form_versions")
}

model Lead {
  id              String    @id @default(cuid())
  clientId        String    @map("client_id")
  lpId            String?   @map("lp_id")
  formVersionId   String?   @map("form_version_id")
  statusId        String?   @map("status_id")
  ownerId         String?   @map("owner_id")
  submissionId    String    @map("submission_id")
  name            String?
  phoneNormalised String?   @map("phone_normalised")
  emailNormalised String?   @map("email_normalised")
  answers         Json      @default("{}")
  tracking        Json      @default("{}")
  consent         Json      @default("{}")
  scores          Json      @default("{}") // quiz points per field_key
  totalScore      Int?      @map("total_score")
  /// Lowercased name, email, phone and answer values; trigram-indexed for fast search.
  searchText      String?   @map("search_text")
  source          String    @default("lp")
  isDuplicate     Boolean   @default(false) @map("is_duplicate")
  duplicateOfId   String?   @map("duplicate_of_id")
  followUpAt      DateTime? @map("follow_up_at")
  /// Labels the team adds by hand ("VIP", "Paid", "No answer"); shown in the tag column.
  tags            String[]  @default([])
  /// In Trash since then (hidden everywhere, restorable until deleted for good).
  deletedAt       DateTime? @map("deleted_at")
  /// Archived since then (hidden from the main list, still counted and searchable under Archived).
  archivedAt      DateTime? @map("archived_at")
  /// Why the lead looks fake ("Phone looks fake", "Test name"…); empty when it looks real.
  junkReasons     String[]  @default([]) @map("junk_reasons")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lp          LandingPage?       @relation(fields: [lpId], references: [id], onDelete: SetNull)
  formVersion FormVersion?       @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  status      PipelineStage?     @relation(fields: [statusId], references: [id], onDelete: SetNull)
  owner       User?              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events      LeadEvent[]
  deliveries  OutboundDelivery[]

  @@unique([lpId, submissionId])
  @@index([clientId, createdAt])
  @@index([lpId, createdAt])
  @@index([createdAt]) // "All clients" view, newest first
  @@index([clientId, phoneNormalised]) // dedupe stays inside one client
  @@index([clientId, emailNormalised])
  @@index([clientId, statusId])
  @@index([tags], type: Gin)
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([clientId, ownerId])
  @@index([duplicateOfId])
  @@index([answers(ops: JsonbPathOps)], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_search_text_trgm_idx")
  @@map("leads")
}

/// Leads per landing page per day (India time), kept in step with `leads` by ingest and delete,
/// so the dashboard sums a few hundred rows instead of counting millions. Rebuild with
/// rebuildDailyCounts() (src/lib/dashboard.ts) if leads are ever changed outside the app.
model LeadDailyCount {
  clientId   String   @map("client_id")
  lpId       String   @default("") @map("lp_id") // "" = no landing page
  day        DateTime @db.Date
  leads      Int      @default(0)
  duplicates Int      @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, lpId, day])
  @@index([day])
  @@map("lead_daily_counts")
}

model PipelineStage {
  id            String  @id @default(cuid())
  clientId      String  @map("client_id")
  name          String
  position      Int
  isWon         Boolean @default(false) @map("is_won")
  isLost        Boolean @default(false) @map("is_lost")
  metaEventName String? @map("meta_event_name")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@index([clientId, position])
  @@map("pipeline_stages")
}

model LeadEvent {
  id        String        @id @default(cuid())
  leadId    String        @map("lead_id")
  type      LeadEventType
  payload   Json          @default("{}")
  actorId   String?       @map("actor_id")
  createdAt DateTime      @default(now()) @map("created_at")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_events")
}

/// Outbound integrations. For type `webhook`: forwards matching new leads to a URL (e.g. Pabbly).
model Integration {
  id         String          @id @default(cuid())
  clientId   String          @map("client_id")
  type       IntegrationType
  name       String          @default("")
  config     String // AES-256-GCM encrypted JSON; webhook: { url }
  /// Lead filter conditions (same shape as the leads screen); empty = every lead.
  conditions Json            @default("[]")
  status     String          @default("active") // active | paused
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at")

  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries OutboundDelivery[]

  @@index([clientId, type])
  @@map("integrations")
}

model OutboundDelivery {
  id            String   @id @default(cuid())
  leadId        String   @map("lead_id")
  integrationId String   @map("integration_id")
  attempt       Int      @default(1)
  status        String
  responseCode  Int?     @map("response_code")
  error         String?
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([leadId])
  @@map("outbound_deliveries")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  clientId  String?  @map("client_id")
  action    String
  target    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("audit_log")
}
