# ---- App ----
DATABASE_URL="postgresql://sabhi:sabhi@localhost:5433/sabhi_leads"
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_TRUST_HOST=true
APP_URL="https://leads.sabhidigital.com"
INGEST_URL="https://ingest.sabhidigital.com"   # used in the snippet shown on LP pages
ENCRYPTION_KEY=""              # openssl rand -hex 32  (AES-256-GCM for integration secrets)
TURNSTILE_SECRET_KEY=""        # empty = Turnstile check skipped (local only)
REDIS_URL=""                   # empty = jobs are skipped (local only)
LOG_LEVEL=info
SEED_PASSWORD=""               # password for demo users created by `pnpm db:seed`

# ---- docker-compose (VPS) ----
# Shared host with Traefik on 80/443 (our VPS): use both files. Leave unset on a dedicated server.
COMPOSE_FILE=docker-compose.yml:docker-compose.shared-host.yml
APP_DOMAIN=leads.sabhidigital.com
INGEST_DOMAIN=ingest.sabhidigital.com
POSTGRES_USER=sabhi
POSTGRES_PASSWORD=
POSTGRES_APP_USER=sabhi_app
POSTGRES_APP_PASSWORD=
BACKUP_PASSPHRASE=
RCLONE_REMOTE=b2:sabhi-backups/leads
