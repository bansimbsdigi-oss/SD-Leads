# Copy to /opt/sabhi-leads-zbot/.env on the VPS, fill in, then: chmod 600 .env
# Never commit the filled-in file.

# ---- keeps this copy separate from the existing sabhi-leads stack ----
COMPOSE_PROJECT_NAME=sabhi-leads-zbot
IMAGE_PREFIX=sabhi-leads-zbot
IMAGE_TAG=latest

# ---- App ----
APP_URL=https://zbot.sabhidigital.com
INGEST_URL=https://zbot.sabhidigital.com
AUTH_TRUST_HOST=true
AUTH_SECRET=                   # openssl rand -base64 32
ENCRYPTION_KEY=                # openssl rand -hex 32
TURNSTILE_SECRET_KEY=          # empty = Turnstile check skipped
LOG_LEVEL=info

# ---- Database (used by docker-compose.yml) ----
POSTGRES_USER=sabhi
POSTGRES_PASSWORD=             # openssl rand -hex 24
POSTGRES_APP_USER=sabhi_app
POSTGRES_APP_PASSWORD=         # openssl rand -hex 24

# Only read by the disabled caddy/backup services; keep so compose can parse the base file.
APP_DOMAIN=zbot.sabhidigital.com
INGEST_DOMAIN=zbot.sabhidigital.com
BACKUP_PASSPHRASE=unused
